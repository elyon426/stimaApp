{
  "expo": {
    "name": "Stima Sacco",
    "slug": "stimaApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/stimaLogo.png",
    "scheme": "stimaapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/stimaLogo.png",
      "bundleIdentifier": "com.stima.app"
    },
    "android": {
      "package": "com.stima.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptiveIconBaPP.png",
        "backgroundColor": "#2d6a2d"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-updates",
      [
        "expo-splash-screen",
        {
          "image": "./assets/stimaLogo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/stimaLogo.png",
            "backgroundColor": "#1a1a1a"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "owner": "elyon001"
  }
}
